<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>YelpCamp — Discover Amazing Campgrounds</title>
  <meta name="description" content="Find, share, and review campgrounds across the country with the YelpCamp community.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous" />
  <script src="https://cdn.maptiler.com/maptiler-sdk-js/v3.6.1/maptiler-sdk.umd.min.js"></script>
  <link href="https://cdn.maptiler.com/maptiler-sdk-js/v3.6.1/maptiler-sdk.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/stylesheets/main.css" />
</head>

<body>
  <%- include('../partials/navbar') %>
  <main class="site-main">
    <div class="container">
      <%- include('../partials/flash') %>
      <%- body %>
    </div>
  </main>
  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
    integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.min.js"
    integrity="sha384-7qAoOXltbVP82dhxHAUje59V5r2YsVfBafyUDxEdApLPmcdhBPg1DKg1ERo0BZlK"
    crossorigin="anonymous"></script>
  <script src="/javascripts/validateForms.js"></script>
  <script src="/javascripts/passwordVisibility.js"></script>
  <script src="/javascripts/passwordToggleStrength.js"></script>
  <script>
    var toggler = document.getElementById('navToggler');
    var navEl = document.getElementById('ycNav');
    var navRight = document.getElementById('ycNavRight');
    if (toggler) {
      toggler.addEventListener('click', function() {
        if (navEl) navEl.classList.toggle('open');
        if (navRight) navRight.classList.toggle('open');
      });
    }
  </script>
</body>

</html>