<% layout('layout/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/register.css">

<div class="container-xxl py-4">
  <div class="airbnb-modal-card">
    <!-- Header -->
    <div class="airbnb-modal-header">
      <h5>Sign up</h5>
    </div>

    <!-- Body -->
    <div class="airbnb-modal-body">
      <h4 class="fw-bold mb-4">Create your YelpCamp account</h4>

      <form id="registerForm" action="/register" method="POST" novalidate class="needs-validation">
        <!-- Segmented Input Box -->
        <div class="airbnb-segmented-input mb-3">
          <div class="segmented-input-row">
            <label for="username">Username</label>
            <input id="username" name="username" type="text" placeholder="Choose a username" required autofocus>
            <div class="invalid-feedback">Username is required.</div>
          </div>
          <div class="segmented-input-row">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" placeholder="name@example.com" required>
            <div class="invalid-feedback">A valid email address is required.</div>
          </div>
          <div class="segmented-input-row position-relative">
            <label for="password">Password</label>
            <div class="d-flex align-items-center">
              <input id="password" name="password" type="password" minlength="6" placeholder="Min. 6 characters" required>
              <button id="togglePwd" type="button" class="btn btn-sm btn-link text-dark text-decoration-none fw-bold p-0 ms-2" aria-label="Toggle password">Show</button>
            </div>
            <div class="invalid-feedback">Password is required (minimum 6 characters).</div>
          </div>
          <div class="segmented-input-row position-relative">
            <label for="confirmPassword">Confirm Password</label>
            <div class="d-flex align-items-center">
              <input id="confirmPassword" name="confirmPassword" type="password" minlength="6" placeholder="Re-enter password" required>
              <button id="toggleConfirmPwd" type="button" class="btn btn-sm btn-link text-dark text-decoration-none fw-bold p-0 ms-2" aria-label="Toggle confirm password">Show</button>
            </div>
            <div class="invalid-feedback">Please confirm your password.</div>
          </div>
        </div>

        <p class="text-secondary small mb-4" style="font-size: 0.76rem;">
          By selecting <strong>Agree and continue</strong>, you agree to YelpCamp's <a href="#" class="text-dark fw-bold text-decoration-underline">Terms of Service</a> and <a href="#" class="text-dark fw-bold text-decoration-underline">Privacy Policy</a>.
        </p>

        <!-- Submit Button -->
        <div class="d-grid mb-3">
          <button id="submitBtn" class="airbnb-primary-btn py-3" type="submit">
            Agree and continue
          </button>
        </div>

        <div class="text-center pt-2">
          <span class="text-secondary small">Already have an account? <a href="/login" class="text-dark fw-bold text-decoration-underline">Log in</a></span>
        </div>
      </form>
    </div>
  </div>
</div>