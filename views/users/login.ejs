<% layout('layout/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/login.css">

<div class="container-xxl py-4">
  <div class="airbnb-modal-card">
    <!-- Header -->
    <div class="airbnb-modal-header">
      <h5>Log in or sign up</h5>
    </div>

    <!-- Body -->
    <div class="airbnb-modal-body">
      <h4 class="fw-bold mb-4">Welcome to YelpCamp</h4>

      <form id="loginForm" action="/login" method="POST" novalidate class="needs-validation">
        <!-- Segmented Input Box -->
        <div class="airbnb-segmented-input mb-3">
          <div class="segmented-input-row">
            <label for="username">Username</label>
            <input id="username" name="username" type="text" placeholder="Enter username" required autofocus>
            <div class="invalid-feedback">Username is required.</div>
          </div>
          <div class="segmented-input-row position-relative">
            <label for="password">Password</label>
            <div class="d-flex align-items-center">
              <input id="password" name="password" type="password" placeholder="Enter password" required>
              <button id="togglePassword" type="button" class="btn btn-sm btn-link text-dark text-decoration-none fw-bold p-0 ms-2" aria-label="Toggle password">Show</button>
            </div>
            <div class="invalid-feedback">Password is required.</div>
          </div>
        </div>

        <p class="text-secondary small mb-4" style="font-size: 0.76rem;">
          We'll send verification details to your account. <a href="#" class="text-dark fw-bold text-decoration-underline">Privacy Policy</a>
        </p>

        <!-- Submit Button -->
        <div class="d-grid mb-3">
          <button id="submitBtn" class="airbnb-primary-btn py-3" type="submit">
            Continue
          </button>
        </div>

        <div class="d-flex align-items-center my-3">
          <hr class="flex-grow-1 my-0">
          <span class="px-3 text-secondary small">or</span>
          <hr class="flex-grow-1 my-0">
        </div>

        <!-- Social Buttons -->
        <div class="d-grid gap-2 mb-3">
          <a href="/register" class="btn btn-outline-dark rounded-2 py-2 fw-semibold small d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-person-plus"></i> Create new YelpCamp account
          </a>
        </div>
      </form>
    </div>
  </div>
</div>