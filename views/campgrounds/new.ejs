<% layout('layout/boilerplate') %>

<div class="container-xl py-5">
  <div class="airbnb-modal-card" style="max-width: 620px;">
    <div class="airbnb-modal-header text-start px-4 pt-4 pb-2 border-0">
      <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fw-bold text-uppercase mb-2" style="font-size: 0.7rem;">
        Host Setup
      </span>
      <h2 class="fw-bold mb-1">YelpCamp your campsite</h2>
      <p class="text-secondary small mb-0">Tell us about your spot to share it with outdoor explorers worldwide.</p>
    </div>

    <div class="airbnb-modal-body px-4 pt-3 pb-4">
      <form action="/campgrounds" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
        
        <!-- Segmented Input Box -->
        <div class="airbnb-segmented-input mb-4">
          <!-- Title -->
          <div class="segmented-input-row">
            <label for="title">Campsite Title</label>
            <input type="text" id="title" name="campground[title]" placeholder="e.g. Pine Ridge Camp Retreat" required>
            <div class="invalid-feedback">Please provide a campsite title.</div>
          </div>

          <!-- Location -->
          <div class="segmented-input-row">
            <label for="location">Location / Address</label>
            <input type="text" id="location" name="campground[location]" placeholder="City, State or National Park" required>
            <div class="invalid-feedback">Please enter a location.</div>
          </div>

          <!-- Price -->
          <div class="segmented-input-row">
            <label for="price">Nightly Rate ($ USD)</label>
            <input type="number" step="0.01" min="0" id="price" name="campground[price]" placeholder="0.00" required>
            <div class="invalid-feedback">Please enter a nightly rate.</div>
          </div>

          <!-- Description -->
          <div class="segmented-input-row">
            <label for="description">Description</label>
            <textarea id="description" name="campground[description]" rows="4" placeholder="Tell guests about your campsite, terrain, wildlife, and amenities..." required></textarea>
            <div class="invalid-feedback">Please provide a description.</div>
          </div>
        </div>

        <!-- Photo Upload Dropzone -->
        <div class="mb-4">
          <label class="form-label fw-bold small text-secondary">Photos</label>
          <label class="d-block text-center p-4 border rounded-3 bg-light cursor-pointer" for="image" style="cursor: pointer;">
            <i class="bi bi-images fs-2 text-secondary d-block mb-2"></i>
            <strong class="d-block text-dark small">Upload high quality photos</strong>
            <span class="small text-muted">Select multiple images to showcase your campsite</span>
            <input type="file" class="d-none" id="image" name="image" multiple accept="image/*" required>
          </label>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
          <a href="/campgrounds" class="text-dark fw-bold text-decoration-underline small">Cancel</a>
          <button class="airbnb-primary-btn" style="width: auto;" type="submit">
            Publish listing
          </button>
        </div>
      </form>
    </div>
  </div>
</div>