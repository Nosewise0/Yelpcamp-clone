<% layout('layout/boilerplate') %>

<div class="container-xl py-5">
  <div class="airbnb-modal-card" style="max-width: 620px;">
    <div class="airbnb-modal-header text-start px-4 pt-4 pb-2 border-0">
      <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fw-bold text-uppercase mb-2" style="font-size: 0.7rem;">
        Edit Listing
      </span>
      <h2 class="fw-bold mb-1">Edit campsite details</h2>
      <p class="text-secondary small mb-0">Keep your listing up to date for guests and campers.</p>
    </div>

    <div class="airbnb-modal-body px-4 pt-3 pb-4">
      <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
        
        <!-- Segmented Input Box -->
        <div class="airbnb-segmented-input mb-4">
          <!-- Title -->
          <div class="segmented-input-row">
            <label for="title">Campsite Title</label>
            <input type="text" id="title" name="campground[title]" value="<%= campground.title %>" required>
            <div class="invalid-feedback">Please enter a title.</div>
          </div>

          <!-- Location -->
          <div class="segmented-input-row">
            <label for="location">Location / Address</label>
            <input type="text" id="location" name="campground[location]" value="<%= campground.location %>" required>
            <div class="invalid-feedback">Please enter a location.</div>
          </div>

          <!-- Price -->
          <div class="segmented-input-row">
            <label for="price">Nightly Rate ($ USD)</label>
            <input type="number" step="0.01" min="0" id="price" name="campground[price]" value="<%= campground.price %>" required>
            <div class="invalid-feedback">Please enter a price.</div>
          </div>

          <!-- Description -->
          <div class="segmented-input-row">
            <label for="description">Description</label>
            <textarea id="description" name="campground[description]" rows="4" required><%= campground.description %></textarea>
            <div class="invalid-feedback">Please provide a description.</div>
          </div>
        </div>

        <!-- Add Photos Dropzone -->
        <div class="mb-4">
          <label class="form-label fw-bold small text-secondary">Add more photos</label>
          <label class="d-block text-center p-3 border rounded-3 bg-light cursor-pointer" for="image" style="cursor: pointer;">
            <i class="bi bi-cloud-arrow-up fs-3 text-secondary d-block mb-1"></i>
            <strong class="d-block text-dark small">Choose new images</strong>
            <span class="small text-muted">Upload high-res photos to refresh your listing</span>
            <input type="file" class="d-none" id="image" name="image" multiple accept="image/*">
          </label>
        </div>

        <!-- Existing Photos Management -->
        <% if (campground.image && campground.image.length > 0) { %>
          <div class="mb-4">
            <label class="form-label fw-bold small text-secondary">Manage existing photos (Select to remove)</label>
            <div class="row g-2">
              <% campground.image.forEach(function(img, i) { %>
                <div class="col-4">
                  <div class="card border rounded-2 overflow-hidden position-relative shadow-sm">
                    <img src="<%= img.thumbnail || img.url %>" class="card-img-top object-fit-cover" style="height: 90px;" alt="Photo">
                    <div class="card-body p-1 text-center bg-light">
                      <div class="form-check d-inline-block">
                        <input class="form-check-input" type="checkbox" id="image<%= i %>" name="deleteImages[]" value="<%= img.filename %>">
                        <label class="form-check-label small text-danger fw-semibold" for="image<%= i %>" style="font-size: 0.72rem;">
                          Delete
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Action Buttons -->
        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
          <a href="/campgrounds/<%= campground._id %>" class="text-dark fw-bold text-decoration-underline small">Cancel</a>
          <button class="airbnb-primary-btn" style="width: auto;" type="submit">
            Save updates
          </button>
        </div>
      </form>
    </div>
  </div>
</div>