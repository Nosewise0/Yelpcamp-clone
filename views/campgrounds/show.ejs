<% layout('layout/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/stars.css" />

<div class="container-xxl py-4">
  <!-- Title & Top Meta Section -->
  <div class="mb-4">
    <h1 class="airbnb-show-title"><%= campground.title %></h1>
    <div class="airbnb-show-subline">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="fw-bold"><i class="bi bi-star-fill text-dark small me-1"></i>4.9</span>
        <span>&bull;</span>
        <a href="#reviewsSection" class="text-dark fw-semibold text-decoration-underline"><%= campground.reviews.length %> reviews</a>
        <span>&bull;</span>
        <span><i class="bi bi-award-fill text-danger me-1"></i>Superhost</span>
        <span>&bull;</span>
        <span class="text-decoration-underline fw-semibold"><%= campground.location %></span>
      </div>
      
      <div class="d-flex gap-3">
        <button class="btn btn-sm btn-link text-dark text-decoration-none fw-semibold p-0"><i class="bi bi-upload me-1"></i> Share</button>
        <button class="btn btn-sm btn-link text-dark text-decoration-none fw-semibold p-0"><i class="bi bi-heart me-1"></i> Save</button>
      </div>
    </div>
  </div>

  <!-- Photo Collage Grid (Airbnb Signature) -->
  <div class="airbnb-photo-grid">
    <% if (campground.image && campground.image.length > 0) { %>
      <img src="<%= campground.image[0].url %>" class="photo-main" alt="<%= campground.title %>">
      <% for (let i = 1; i < 5; i++) { %>
        <% if (campground.image[i]) { %>
          <img src="<%= campground.image[i].url %>" alt="Campground photo">
        <% } else { %>
          <img src="<%= campground.image[0].url %>" alt="Campground photo">
        <% } %>
      <% } %>
    <% } else { %>
      <img src="https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80" class="photo-main" alt="Default hero">
      <img src="https://images.unsplash.com/photo-1510312305653-8ed496efae75?auto=format&fit=crop&w=600&q=80" alt="Photo 2">
      <img src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=600&q=80" alt="Photo 3">
      <img src="https://images.unsplash.com/photo-1537905569824-f89f14cceb68?auto=format&fit=crop&w=600&q=80" alt="Photo 4">
      <img src="https://images.unsplash.com/photo-1492648272180-61e45a8d98a7?auto=format&fit=crop&w=600&q=80" alt="Photo 5">
    <% } %>
  </div>

  <div class="row g-5">
    <!-- Left Column: Details, Host, Amenities, Map, Reviews -->
    <div class="col-lg-7 col-xl-8">
      <!-- Host Header -->
      <div class="airbnb-host-row">
        <div>
          <h3 class="h4 fw-bold mb-1">Campsite hosted by <%= campground.author ? campground.author.username : 'Superhost' %></h3>
          <p class="text-secondary mb-0">6 guests &bull; 2 tent sites &bull; 1 fire pit &bull; 1 shared bath</p>
        </div>
        <div class="airbnb-host-avatar">
          <%= campground.author ? campground.author.username.charAt(0).toUpperCase() : 'H' %>
        </div>
      </div>

      <!-- Highlights -->
      <div class="pb-4 border-bottom border-light mb-4">
        <div class="airbnb-highlight-item">
          <i class="bi bi-door-open"></i>
          <div>
            <h6 class="fw-bold mb-1">Self check-in</h6>
            <p class="text-secondary small mb-0">Check yourself in with the digital keypad or onsite camp lockbox.</p>
          </div>
        </div>
        <div class="airbnb-highlight-item">
          <i class="bi bi-geo-alt"></i>
          <div>
            <h6 class="fw-bold mb-1">Great location</h6>
            <p class="text-secondary small mb-0">95% of recent guests gave the location a 5-star rating.</p>
          </div>
        </div>
        <div class="airbnb-highlight-item mb-0">
          <i class="bi bi-calendar-check"></i>
          <div>
            <h6 class="fw-bold mb-1">Free cancellation for 48 hours</h6>
            <p class="text-secondary small mb-0">Get a full refund if you change your plans within 48 hours of booking.</p>
          </div>
        </div>
      </div>

      <!-- AirCover Guarantee Badge -->
      <div class="pb-4 border-bottom border-light mb-4">
        <h4 class="fw-bold mb-2 text-danger">air<span class="text-dark">cover</span></h4>
        <p class="text-secondary small mb-2">Every booking includes free protection from Host cancellations, listing inaccuracies, and other issues like trouble checking in.</p>
        <a href="#" class="text-dark fw-bold small text-decoration-underline">Learn more</a>
      </div>

      <!-- Description -->
      <div class="pb-4 border-bottom border-light mb-4">
        <h4 class="h5 fw-bold mb-3">About this space</h4>
        <p class="text-secondary lh-lg mb-0"><%= campground.description %></p>
      </div>

      <!-- What this place offers (Amenities) -->
      <div class="pb-4 border-bottom border-light mb-4">
        <h4 class="h5 fw-bold mb-4">What this place offers</h4>
        <div class="airbnb-amenity-grid">
          <div class="airbnb-amenity-row"><i class="bi bi-tree"></i> Mountain & forest view</div>
          <div class="airbnb-amenity-row"><i class="bi bi-water"></i> Lake & waterfront access</div>
          <div class="airbnb-amenity-row"><i class="bi bi-fire"></i> Private campfire pit</div>
          <div class="airbnb-amenity-row"><i class="bi bi-p-circle"></i> Free parking on premises</div>
          <div class="airbnb-amenity-row"><i class="bi bi-heart"></i> Pets allowed</div>
          <div class="airbnb-amenity-row"><i class="bi bi-cup-hot"></i> Potable drinking water</div>
        </div>
      </div>

      <!-- Where you'll be (Location Map Section) -->
      <div class="pb-4 border-bottom border-light mb-4">
        <h4 class="h5 fw-bold mb-2">Where you'll be</h4>
        <p class="text-secondary mb-3"><i class="bi bi-geo-alt me-1"></i> <%= campground.location %></p>
        <div class="rounded-4 overflow-hidden border shadow-sm" style="height: 380px; width: 100%;">
          <div id="map" style="width: 100%; height: 100%;"></div>
        </div>
      </div>

      <!-- Host Action Controls (If Author) -->
      <% if (currentUser && campground.author && campground.author._id.equals(currentUser._id)) { %>
        <div class="pb-4 border-bottom border-light mb-4">
          <h5 class="fw-bold mb-3">Host Controls</h5>
          <div class="d-flex gap-2">
            <a href="/campgrounds/<%= campground._id %>/edit" class="airbnb-btn-outline">
              <i class="bi bi-pencil me-1"></i> Edit Listing
            </a>
            <form class="d-inline" action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST">
              <button class="btn btn-outline-danger rounded-2 fw-semibold px-3 py-2">
                <i class="bi bi-trash3 me-1"></i> Delete
              </button>
            </form>
          </div>
        </div>
      <% } %>

      <!-- Reviews Section -->
      <div id="reviewsSection" class="pt-2">
        <h3 class="h4 fw-bold mb-4">
          <i class="bi bi-star-fill text-dark me-1 small"></i> 4.9 &bull; <%= campground.reviews.length %> reviews
        </h3>

        <!-- Category Ratings Breakdown -->
        <div class="airbnb-review-category-grid">
          <div class="airbnb-rating-bar-container">
            <span>Cleanliness</span>
            <div class="airbnb-progress-bar"><div class="airbnb-progress-fill" style="width: 98%;"></div></div>
            <span class="fw-bold small">4.9</span>
          </div>
          <div class="airbnb-rating-bar-container">
            <span>Accuracy</span>
            <div class="airbnb-progress-bar"><div class="airbnb-progress-fill" style="width: 100%;"></div></div>
            <span class="fw-bold small">5.0</span>
          </div>
          <div class="airbnb-rating-bar-container">
            <span>Communication</span>
            <div class="airbnb-progress-bar"><div class="airbnb-progress-fill" style="width: 96%;"></div></div>
            <span class="fw-bold small">4.8</span>
          </div>
          <div class="airbnb-rating-bar-container">
            <span>Location</span>
            <div class="airbnb-progress-bar"><div class="airbnb-progress-fill" style="width: 100%;"></div></div>
            <span class="fw-bold small">5.0</span>
          </div>
          <div class="airbnb-rating-bar-container">
            <span>Check-in</span>
            <div class="airbnb-progress-bar"><div class="airbnb-progress-fill" style="width: 98%;"></div></div>
            <span class="fw-bold small">4.9</span>
          </div>
          <div class="airbnb-rating-bar-container">
            <span>Value</span>
            <div class="airbnb-progress-bar"><div class="airbnb-progress-fill" style="width: 94%;"></div></div>
            <span class="fw-bold small">4.7</span>
          </div>
        </div>

        <!-- Reviews List -->
        <% if (campground.reviews.length === 0) { %>
          <p class="text-secondary">No reviews yet for this campground. Be the first to leave a review below!</p>
        <% } else { %>
          <div class="row g-4 mb-4">
            <% for (let review of campground.reviews) { %>
              <div class="col-md-6">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <div class="d-flex align-items-center gap-3">
                    <div class="airbnb-avatar bg-dark text-white">
                      <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div>
                      <h6 class="fw-bold mb-0 text-dark"><%= review.author ? review.author.username : 'Camper' %></h6>
                      <small class="text-muted">October 2026</small>
                    </div>
                  </div>

                  <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
                    <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="d-inline">
                      <button class="btn btn-sm text-secondary border-0 p-0" title="Delete Review">
                        <i class="bi bi-trash3"></i>
                      </button>
                    </form>
                  <% } %>
                </div>

                <p class="starability-result mb-1" data-rating="<%= review.rating %>">
                  Rated: <%= review.rating %> stars
                </p>
                <p class="text-secondary small mb-0"><%= review.body %></p>
              </div>
            <% } %>
          </div>
        <% } %>

        <!-- Leave A Review Box -->
        <% if (currentUser) { %>
          <div class="card p-4 rounded-3 border bg-white mt-4">
            <h5 class="fw-bold mb-3">Leave a review for this campsite</h5>
            <form action="/campgrounds/<%= campground._id %>/reviews" method="POST" class="needs-validation" novalidate>
              <div class="mb-3">
                <label class="form-label fw-bold small text-secondary">Rating</label>
                <fieldset class="starability-basic">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold small text-secondary" for="body">Your Review</label>
                <textarea class="form-control rounded-2 p-3" name="review[body]" id="body" rows="3" placeholder="Share your experience at this campsite..." required></textarea>
                <div class="invalid-feedback">Please write a review.</div>
              </div>

              <button class="airbnb-btn-primary">
                Post Review
              </button>
            </form>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column: Sticky Airbnb Reservation Card ONLY -->
    <div class="col-lg-5 col-xl-4">
      <div class="airbnb-reserve-card">
        <!-- Price Header -->
        <div class="airbnb-price-header">
          <div>
            <span class="price-amount">$<%= campground.price %></span>
            <span class="text-secondary small"> night</span>
          </div>
          <div class="small fw-semibold">
            <i class="bi bi-star-fill text-dark me-1 small"></i> 4.9 &bull; <span class="text-secondary"><%= campground.reviews.length %> reviews</span>
          </div>
        </div>

        <!-- Date / Guest Selector Box -->
        <div class="airbnb-reserve-box">
          <div class="airbnb-reserve-dates">
            <div class="airbnb-date-field">
              <span class="airbnb-date-label">Check-in</span>
              <span class="airbnb-date-val">10/24/2026</span>
            </div>
            <div class="airbnb-date-field">
              <span class="airbnb-date-label">Checkout</span>
              <span class="airbnb-date-val">10/29/2026</span>
            </div>
          </div>
          <div class="p-2 px-3">
            <span class="airbnb-date-label">Guests</span>
            <span class="airbnb-date-val">2 guests, 1 tent</span>
          </div>
        </div>

        <!-- Reserve CTA Button -->
        <button class="airbnb-reserve-btn" type="button">
          Reserve
        </button>

        <p class="text-center text-secondary small mt-2 mb-0">You won't be charged yet</p>

        <!-- Price Breakdown -->
        <div class="airbnb-price-breakdown">
          <div class="airbnb-price-row">
            <span>$<%= campground.price %> x 5 nights</span>
            <span>$<%= campground.price * 5 %></span>
          </div>
          <div class="airbnb-price-row">
            <span>Cleaning fee</span>
            <span>$35</span>
          </div>
          <div class="airbnb-price-row">
            <span>YelpCamp service fee</span>
            <span>$45</span>
          </div>
          <div class="airbnb-price-total">
            <span>Total before taxes</span>
            <span>$<%= (campground.price * 5) + 80 %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- "<script>" %>
  const maptilerApiKey = '<%- process.env.MAPTILER_API_KEY %>';
  const campground = <%- JSON.stringify(campground) %>;
<%- "</script>" %>

<script src="/javascripts/showPageMap.js"></script>