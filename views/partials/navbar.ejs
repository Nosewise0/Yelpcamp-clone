<header class="airbnb-header">
  <div class="container-xxl">
    <div class="airbnb-navbar">
      <!-- YelpCamp Logo -->
      <a class="airbnb-logo-wrap" href="/">
        <span class="airbnb-logo-mark" aria-hidden="true">
          <img src="/images/yelpcamp-icon.svg" alt="" />
        </span>
        <span>yelpcamp</span>
      </a>

      <!-- Center Search Capsule (Airbnb Signature) -->
      <a href="/campgrounds" class="airbnb-search-bar d-none d-md-inline-flex text-decoration-none">
        <span class="search-segment">Campgrounds</span>
        <span class="search-divider"></span>
        <span class="search-segment">View Campsite</span>
      </a>

      <!-- Right Nav Actions -->
      <div class="d-flex align-items-center gap-2">
        <a href="/campgrounds/new" class="airbnb-host-btn d-none d-lg-inline-block text-decoration-none">
          YelpCamp your campsite
        </a>

        <!-- <button class="btn btn-link text-dark text-decoration-none p-2 rounded-circle hover-bg d-none d-sm-inline-block"
          type="button" aria-label="Language & Currency">
          <i class="bi bi-globe fs-6"></i>
        </button> -->

        <!-- User Profile Dropdown Pill -->
        <div class="dropdown">
          <button class="airbnb-user-menu-btn bg-white" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-list fs-5 text-dark"></i>
            <% if (currentUser) { %>
              <div class="airbnb-user-avatar bg-dark text-white">
                <%= currentUser.username.charAt(0).toUpperCase() %>
              </div>
              <% } else { %>
                <div class="airbnb-user-avatar bg-secondary text-white">
                  <i class="bi bi-person-fill"></i>
                </div>
                <% } %>
          </button>

          <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-3 py-2 border-0 mt-2"
            style="min-width: 240px; font-size: 0.92rem;">
            <% if (!currentUser) { %>
              <li><a class="dropdown-item fw-bold py-2" href="/register">Sign up</a></li>
              <li><a class="dropdown-item py-2" href="/login">Log in</a></li>
              <li>
                <hr class="dropdown-divider my-2">
              </li>
              <li><a class="dropdown-item py-2" href="/campgrounds">Explore Campgrounds</a></li>
              <li><a class="dropdown-item py-2" href="/campgrounds/new">Host your campsite</a></li>
              <li><a class="dropdown-item py-2" href="#">Help Center</a></li>
              <% } else { %>
                <li class="px-3 py-2 text-muted small">Signed in as <strong class="text-dark">
                    <%= currentUser.username %>
                  </strong></li>
                <li>
                  <hr class="dropdown-divider my-1">
                </li>
                <li><a class="dropdown-item py-2" href="/campgrounds">Explore Campgrounds</a></li>
                <li><a class="dropdown-item py-2" href="/campgrounds/new">Host your campsite</a></li>
                <li>
                  <hr class="dropdown-divider my-1">
                </li>
                <li><a class="dropdown-item py-2 text-danger" href="/logout">Log out</a></li>
                <% } %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hover-bg:hover {
    background-color: #F7F7F7;
  }
</style>