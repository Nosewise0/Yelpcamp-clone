<% layout('layout/boilerplate') %>

<div class="container-xl py-5">
  <!-- AirCover Hero -->
  <div class="text-center py-4 mb-5">
    <h1 class="display-4 fw-bold mb-2">
      <span class="text-danger">air</span><span class="text-dark">cover</span>
    </h1>
    <h2 class="display-6 fw-bold mb-3">Top-to-bottom protection for every stay.</h2>
    <p class="lead text-secondary mx-auto" style="max-width: 680px;">
      Always included and always free. Every YelpCamp booking comes with AirCover protection from host cancellations, listing inaccuracies, and check-in issues.
    </p>
  </div>

  <!-- Comparison Table Card -->
  <div class="card border rounded-4 shadow-sm p-4 p-md-5 mb-5 bg-white">
    <h4 class="fw-bold mb-4">What's included with AirCover</h4>
    
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr class="text-secondary small">
            <th scope="col" style="width: 50%;">PROTECTION FEATURE</th>
            <th scope="col" class="text-center" style="width: 25%;">YELPCAMP AIRCOVER</th>
            <th scope="col" class="text-center" style="width: 25%;">OTHER SITES</th>
          </tr>
        </thead>
        <tbody class="border-top">
          <tr>
            <td class="py-3">
              <strong class="d-block text-dark">Booking Protection Guarantee</strong>
              <small class="text-secondary">If a host cancels your booking within 30 days of check-in, we'll find you a similar or better spot, or refund you 100%.</small>
            </td>
            <td class="text-center text-success fs-5"><i class="bi bi-check-circle-fill"></i></td>
            <td class="text-center text-muted fs-5"><i class="bi bi-x-circle"></i></td>
          </tr>
          <tr>
            <td class="py-3">
              <strong class="d-block text-dark">Check-In Guarantee</strong>
              <small class="text-secondary">If you can’t get into your campsite and the host can’t resolve the issue, we’ll rebook you or issue an immediate refund.</small>
            </td>
            <td class="text-center text-success fs-5"><i class="bi bi-check-circle-fill"></i></td>
            <td class="text-center text-muted fs-5"><i class="bi bi-x-circle"></i></td>
          </tr>
          <tr>
            <td class="py-3">
              <strong class="d-block text-dark">Get-What-You-Booked Guarantee</strong>
              <small class="text-secondary">If the campsite is significantly different than advertised (e.g. missing waterfront access), you have 3 days to report it.</small>
            </td>
            <td class="text-center text-success fs-5"><i class="bi bi-check-circle-fill"></i></td>
            <td class="text-center text-muted fs-5"><i class="bi bi-dash-circle"></i></td>
          </tr>
          <tr>
            <td class="py-3">
              <strong class="d-block text-dark">24-Hour Safety Helpline</strong>
              <small class="text-secondary">If you ever feel unsafe on the campground, you'll get priority access to specially trained safety agents day or night.</small>
            </td>
            <td class="text-center text-success fs-5"><i class="bi bi-check-circle-fill"></i></td>
            <td class="text-center text-muted fs-5"><i class="bi bi-x-circle"></i></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- AirCover for Hosts Section -->
  <div class="p-5 rounded-4 bg-dark text-white mb-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #181b22 0%, #222630 100%);">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <span class="badge bg-danger rounded-pill px-3 py-1 fw-bold text-uppercase mb-3" style="font-size: 0.7rem;">For Campsite Hosts</span>
        <h3 class="display-6 fw-bold mb-3">AirCover for Hosts</h3>
        <p class="text-secondary lead mb-4">Complete protection every time you host on YelpCamp. Includes $1M damage protection, $1M liability insurance, and 24-hour safety line.</p>
        <a href="/campgrounds/new" class="airbnb-primary-btn" style="width: auto;">
          Host with AirCover
        </a>
      </div>
      <div class="col-lg-4 text-center d-none d-lg-block">
        <i class="bi bi-shield-fill-check text-danger opacity-75" style="font-size: 8rem;"></i>
      </div>
    </div>
  </div>
</div>
