<% layout('layout/boilerplate') %>

<div class="container-xl py-5">
  <!-- Host Hero -->
  <div class="row align-items-center mb-5 pb-4">
    <div class="col-lg-7">
      <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fw-bold text-uppercase mb-3" style="font-size: 0.75rem;">
        Hosting on YelpCamp
      </span>
      <h1 class="display-4 fw-bold mb-3">Turn your extra land into meaningful income</h1>
      <p class="lead text-secondary mb-4">
        Join a growing network of landowners, farmers, and outdoor hosts sharing scenic properties with responsible campers.
      </p>
      <a href="/campgrounds/new" class="airbnb-primary-btn px-4 py-3 fs-6">
        <i class="bi bi-plus-circle me-2"></i> Start hosting today
      </a>
    </div>
    <div class="col-lg-5 text-center mt-4 mt-lg-0">
      <div class="rounded-4 overflow-hidden shadow-lg" style="height: 340px;">
        <img src="https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=800&q=80" class="w-100 h-100 object-fit-cover" alt="Hosting campsite">
      </div>
    </div>
  </div>

  <!-- 3 Steps to Hosting -->
  <div class="my-5 py-4 border-top">
    <h2 class="fw-bold mb-4 text-center">Hosting in 3 simple steps</h2>
    <div class="row g-4 text-center mt-2">
      <div class="col-md-4">
        <div class="p-3">
          <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-3" style="width: 64px; height: 64px;">
            <i class="bi bi-camera-fill fs-3"></i>
          </div>
          <h5 class="fw-bold mb-2">1. List your space</h5>
          <p class="text-secondary small mb-0">Add your campsite title, location, description, and high-resolution photos of the campsite and surrounding views.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="p-3">
          <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-3" style="width: 64px; height: 64px;">
            <i class="bi bi-cash-coin fs-3"></i>
          </div>
          <h5 class="fw-bold mb-2">2. Set your price & rules</h5>
          <p class="text-secondary small mb-0">Choose your nightly rate, specify allowable guest sizes, campfire policies, and pet rules.</p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="p-3">
          <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-3" style="width: 64px; height: 64px;">
            <i class="bi bi-shield-check fs-3"></i>
          </div>
          <h5 class="fw-bold mb-2">3. Welcome campers with AirCover</h5>
          <p class="text-secondary small mb-0">Every booking includes top-to-bottom $1M host damage protection and 24/7 support line.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Earnings Estimator Banner -->
  <div class="airbnb-host-banner my-5">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <h2 class="fw-bold mb-2">How much could you earn?</h2>
        <p class="mb-4">Hosts in popular national park regions earn an average of <strong class="text-white">$1,420 / week</strong> with just 2 tent sites.</p>
        <a href="/campgrounds/new" class="airbnb-host-white-btn">
          Get started
        </a>
      </div>
      <div class="col-lg-4 text-end d-none d-lg-block">
        <i class="bi bi-tree text-white opacity-75" style="font-size: 7rem;"></i>
      </div>
    </div>
  </div>
</div>
