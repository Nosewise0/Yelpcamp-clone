<% layout('layout/boilerplate') %>

<div class="container-xl py-5">
  <!-- About Hero -->
  <div class="text-center py-4 mb-5">
    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 fw-bold text-uppercase mb-3" style="font-size: 0.75rem;">
      Our Story
    </span>
    <h1 class="display-5 fw-bold mb-3">Belong anywhere in the wilderness</h1>
    <p class="lead text-secondary mx-auto" style="max-width: 680px;">
      YelpCamp was born from a simple idea: making it effortless for anyone to discover hidden camping spots, support local landowners, and share outdoor adventures.
    </p>
  </div>

  <!-- Big Image Banner -->
  <div class="rounded-4 overflow-hidden mb-5 position-relative shadow-sm" style="height: 400px;">
    <img src="https://images.unsplash.com/photo-1510312305653-8ed496efae75?auto=format&fit=crop&w=1600&q=80" class="w-100 h-100 object-fit-cover" alt="Campers in wilderness">
  </div>

  <!-- Mission & Values Grid -->
  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card h-100 border rounded-4 p-4 shadow-sm">
        <i class="bi bi-compass text-danger fs-2 mb-3"></i>
        <h5 class="fw-bold mb-2">Community Driven</h5>
        <p class="text-secondary small mb-0">Every listing, photo, and review is contributed by real outdoor enthusiasts and verified campsite hosts.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 border rounded-4 p-4 shadow-sm">
        <i class="bi bi-tree text-danger fs-2 mb-3"></i>
        <h5 class="fw-bold mb-2">Leave No Trace</h5>
        <p class="text-secondary small mb-0">We champion sustainable outdoor recreation and partner with conservation efforts to preserve natural habitats.</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 border rounded-4 p-4 shadow-sm">
        <i class="bi bi-people text-danger fs-2 mb-3"></i>
        <h5 class="fw-bold mb-2">Empowering Hosts</h5>
        <p class="text-secondary small mb-0">We help farmers, ranchers, and land stewards generate income while sharing beautiful vistas with the world.</p>
      </div>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="row g-3 text-center my-5 py-4 border-top border-bottom">
    <div class="col-6 col-md-3">
      <h2 class="display-6 fw-bold text-dark mb-1">50K+</h2>
      <p class="text-secondary small mb-0">Verified Campers</p>
    </div>
    <div class="col-6 col-md-3">
      <h2 class="display-6 fw-bold text-dark mb-1">1,200+</h2>
      <p class="text-secondary small mb-0">Scenic Campsites</p>
    </div>
    <div class="col-6 col-md-3">
      <h2 class="display-6 fw-bold text-dark mb-1">4.9/5</h2>
      <p class="text-secondary small mb-0">Average Rating</p>
    </div>
    <div class="col-6 col-md-3">
      <h2 class="display-6 fw-bold text-dark mb-1">50</h2>
      <p class="text-secondary small mb-0">States Covered</p>
    </div>
  </div>

  <!-- Careers / News CTA -->
  <div class="card border rounded-4 p-5 text-center bg-light">
    <h3 class="fw-bold mb-2">Join our mission</h3>
    <p class="text-secondary small mb-4">We are always looking for passionate designers, engineers, and outdoor advocates.</p>
    <div>
      <a href="/campgrounds" class="airbnb-primary-btn">
        Explore YelpCamp
      </a>
    </div>
  </div>
</div>
